# -----------------------------------------------------------------------------
# PostgreSQL Aiven - production Render
# Copiez uniquement les valeurs nécessaires dans Environment > Render.
# Ne commitez jamais ce fichier après y avoir placé de vrais secrets.
# -----------------------------------------------------------------------------

# Aiven Console > PostgreSQL service > Connect
# IMPORTANT : Spring attend une URL JDBC, pas l'URI postgres:// fournie telle quelle.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/defaultdb?sslmode=require
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=change_me

# Pool Hikari applicatif. Aiven Free autorise 20 connexions au total.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_VALIDATION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_KEEPALIVE_TIME_MS=120000

# Après import de la base Neon, Hibernate doit vérifier le schéma sans le modifier.
JPA_DDL_AUTO=validate

PORTFOLIO_ADMIN_USERNAME=admin
PORTFOLIO_ADMIN_PASSWORD=change_me
APP_ANALYTICS_HASH_SECRET=change_me_with_a_long_random_secret

APP_CORS_ALLOWED_ORIGINS=https://idris-achabou.fit,https://professional-website-front.achabou02idris.workers.dev
APP_FRONTEND_ALLOWED_ORIGINS=https://idris-achabou.fit,https://professional-website-front.achabou02idris.workers.dev
APP_FRONTEND_ORIGIN=https://idris-achabou.fit

STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio


# LibreTranslate is private: Spring Boot calls it, never the public React app.
LIBRETRANSLATE_ENABLED=true
LIBRETRANSLATE_BASE_URL=http://libretranslate:5000
LIBRETRANSLATE_TIMEOUT=45s
LIBRETRANSLATE_IMAGE=libretranslate/libretranslate:v1.9.6
