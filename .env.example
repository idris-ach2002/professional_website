POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=change_me

PORTFOLIO_ADMIN_USERNAME=admin
PORTFOLIO_ADMIN_PASSWORD=change_me

# Local front URL. In production, set both to the exact Cloudflare origin.
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
APP_FRONTEND_ORIGIN=http://localhost:5173

JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
HIBERNATE_FORMAT_SQL=true
HIBERNATE_HIGHLIGHT_SQL=true

UPLOAD_DIR=/app/uploads

# local | cloudinary
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio


# LibreTranslate is private: Spring Boot calls it, never the public React app.
LIBRETRANSLATE_ENABLED=true
LIBRETRANSLATE_BASE_URL=http://libretranslate:5000
LIBRETRANSLATE_TIMEOUT=45s
LIBRETRANSLATE_IMAGE=libretranslate/libretranslate:v1.9.6

# V22 performance / concurrency overrides (0 = auto-size from available processors)
APP_CPU_CORE_SIZE=0
APP_CPU_MAX_SIZE=0
APP_CPU_QUEUE_CAPACITY=128
APP_IO_CORE_SIZE=0
APP_IO_MAX_SIZE=0
APP_IO_QUEUE_CAPACITY=128
APP_MAINTENANCE_CORE_SIZE=1
APP_MAINTENANCE_MAX_SIZE=2
APP_MAINTENANCE_QUEUE_CAPACITY=64
APP_ANALYTICS_QUEUE_CAPACITY=512
APP_ANALYTICS_BATCH_SIZE=32
APP_ANALYTICS_FLUSH_INTERVAL_MS=750
APP_ANALYTICS_MAX_EVENTS_PER_MINUTE=120
APP_UPLOAD_MAX_BYTES=10485760
HIBERNATE_BATCH_FETCH_SIZE=32
HIBERNATE_JDBC_BATCH_SIZE=32

# V22 bounded Java 21 virtual-thread lane
APP_VIRTUAL_IO_MAX_CONCURRENCY=0
